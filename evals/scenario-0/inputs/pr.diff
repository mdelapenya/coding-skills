-const session = require('express-session');
-const MongoStore = require('connect-mongo');
+const jwt = require('jsonwebtoken');

-module.exports = {
-  sessionMiddleware: session({
-    secret: process.env.SESSION_SECRET,
-    store: MongoStore.create({ mongoUrl: process.env.MONGO_URI }),
-    resave: false,
-    saveUninitialized: false,
-    cookie: { httpOnly: true, maxAge: 7 * 24 * 60 * 60 * 1000 }
-  }),
-
-  requireAuth: (req, res, next) => {
-    if (!req.session.userId) {
-      return res.status(401).json({ error: 'Not authenticated' });
-    }
-    req.user = { id: req.session.userId };
-    next();
-  }
-};
+const JWT_SECRET = process.env.JWT_SECRET;
+const JWT_EXPIRY = '7d';
+
+/*
+ * BREAKING CHANGE: Session-based authentication has been replaced with
+ * stateless JWT authentication. All existing sessions are immediately
+ * invalidated. API clients must re-authenticate via POST /auth/login
+ * to receive a JWT and include it as a Bearer token in future requests.
+ */
+
+function issueToken(userId) {
+  return jwt.sign({ sub: userId }, JWT_SECRET, { expiresIn: JWT_EXPIRY });
+}
+
+function requireAuth(req, res, next) {
+  const authHeader = req.headers.authorization;
+  if (!authHeader || !authHeader.startsWith('Bearer ')) {
+    return res.status(401).json({ error: 'Missing or invalid Authorization header' });
+  }
+  const token = authHeader.slice(7);
+  try {
+    const payload = jwt.verify(token, JWT_SECRET);
+    req.user = { id: payload.sub };
+    next();
+  } catch (err) {
+    return res.status(401).json({ error: 'Invalid or expired token' });
+  }
+}
+
+module.exports = { issueToken, requireAuth };
