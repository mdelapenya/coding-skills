@@ -0,0 +1,32 @@
+import pytest
+from unittest.mock import MagicMock, patch
+from src.cache.redis_client import cache_get, cache_set
+
+@pytest.fixture
+def mock_redis():
+    with patch("src.cache.redis_client._get_client") as mock:
+        yield mock.return_value
+
+def test_cache_miss(mock_redis):
+    mock_redis.get.return_value = None
+    result = cache_get("user:999")
+    assert result is None
+    mock_redis.get.assert_called_once_with("user:999")
+
+def test_cache_hit(mock_redis):
+    mock_redis.get.return_value = b'{"id": 1, "name": "Alice"}'
+    result = cache_get("user:1")
+    assert result == {"id": 1, "name": "Alice"}
+
+def test_cache_set_with_ttl(mock_redis):
+    cache_set("user:1", {"id": 1, "name": "Alice"}, ttl=60)
+    mock_redis.setex.assert_called_once_with("user:1", 60, '{"id": 1, "name": "Alice"}')
+
+def test_cache_set_default_ttl(mock_redis):
+    cache_set("user:2", {"id": 2})
+    mock_redis.setex.assert_called_once_with("user:2", 300, '{"id": 2}')
